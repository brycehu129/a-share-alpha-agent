[Unit]
Description=Alpha Shadow 抗跌扫描（大盘跌时横住/向上 + 主力资金 + 板块强势 → intraday/resilience-<日期>.jsonl）
After=network-online.target

[Service]
Type=oneshot
# PRIVATE_DATA_DIR / CONFIG_PATH 等都在这个文件里；留存落在其下的 intraday/，不进 git。
EnvironmentFile=/etc/alpha-shadow.env
ExecStart=/bin/bash /opt/alpha-shadow/server/cron_resilience.sh
# 每轮 3 次东财请求 + 1 次腾讯报价。实测一轮约 20 秒（含被限流时的重试），
# 超过 40 秒直接杀掉，别拖到下一轮去和它重叠。
TimeoutStartSec=40
